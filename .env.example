# Google Gemini / AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-lite-image

# Monid API (ByteDance Seedance 2.0 / Kling 3.0)
MONID_API_KEY=your_monid_api_key_here
MONID_API_URL=https://api.monid.com/v1

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=scrollworld-media
R2_PUBLIC_URL=https://media.scrollworld.app

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scrollworld?schema=public"

# Redis (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
